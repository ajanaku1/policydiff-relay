{
  "name": "AuditPacket",
  "type": "object",
  "properties": {
    "organization_id": { "type": "string", "minLength": 1 },
    "requested_by_user_id": { "type": "string", "minLength": 1 },
    "trail_cutoff_at": { "type": "string", "format": "date-time" },
    "private_file_uri": {
      "type": "string",
      "minLength": 1,
      "rls": {
        "read": false,
        "write": false
      }
    },
    "packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dedupe_key": { "type": "string", "minLength": 1 }
  },
  "required": [
    "organization_id",
    "requested_by_user_id",
    "trail_cutoff_at",
    "private_file_uri",
    "packet_hash",
    "dedupe_key"
  ],
  "rls": {
    "create": false,
    "read": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        {
          "user_condition": {
            "data.policy_role": {
              "$in": ["policy_admin", "auditor"]
            }
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}

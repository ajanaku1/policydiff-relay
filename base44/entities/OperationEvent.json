{
  "name": "OperationEvent",
  "type": "object",
  "properties": {
    "organization_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "resource_type": { "type": "string", "minLength": 1 },
    "resource_id": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "from_state": { "type": "string" },
    "to_state": { "type": "string" },
    "outcome": {
      "type": "string",
      "enum": ["succeeded", "rejected", "retryable", "failed"]
    },
    "safe_error_code": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 0, "default": 0 },
    "duration_ms": { "type": "integer", "minimum": 0 }
  },
  "required": [
    "organization_id",
    "correlation_id",
    "resource_type",
    "resource_id",
    "operation",
    "outcome"
  ],
  "rls": {
    "create": false,
    "read": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        {
          "user_condition": {
            "data.policy_role": {
              "$in": ["policy_admin", "auditor"]
            }
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}

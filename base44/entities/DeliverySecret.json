{
  "name": "DeliverySecret",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "rls": { "read": false, "write": false }
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1,
      "rls": { "read": false, "write": false }
    },
    "recipient_name": {
      "type": "string",
      "rls": { "read": false, "write": false }
    },
    "recipient_email": {
      "type": "string",
      "format": "email",
      "rls": { "read": false, "write": false }
    },
    "token_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "rls": { "read": false, "write": false }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "rls": { "read": false, "write": false }
    },
    "used_at": {
      "type": "string",
      "format": "date-time",
      "rls": { "read": false, "write": false }
    }
  },
  "required": [
    "organization_id",
    "delivery_id",
    "recipient_email",
    "token_hash",
    "expires_at"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}

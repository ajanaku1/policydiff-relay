{
  "name": "Policy",
  "type": "object",
  "properties": {
    "organization_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source_file_id": { "type": "string", "minLength": 1 },
    "active_version_id": { "type": "string" },
    "dedupe_key": { "type": "string", "minLength": 1 }
  },
  "required": ["organization_id", "name", "source_file_id", "dedupe_key"],
  "rls": {
    "create": false,
    "read": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        {
          "user_condition": {
            "data.policy_role": {
              "$in": ["policy_admin", "reviewer", "auditor", "staff"]
            }
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}
